{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ProofsBucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "*"
    },
    {
      "Sid": "Cognito",
      "Effect": "Allow",
      "Action": "cognito-idp:*",
      "Resource": "*"
    },
    {
      "Sid": "Amplify",
      "Effect": "Allow",
      "Action": "amplify:*",
      "Resource": "*"
    },
    {
      "Sid": "CreateAmplifyRoleAndPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:CreatePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateAmplifyServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "amplify.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageAmplifyRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags"
      ],
      "Resource": "arn:aws:iam::868112351099:role/condoledger-prod-amplify-*"
    },
    {
      "Sid": "ManageAmplifyPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:ListPolicyVersions",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "arn:aws:iam::868112351099:policy/condoledger-prod-amplify-*"
    },
    {
      "Sid": "PassRoleToAmplify",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::868112351099:role/condoledger-prod-amplify-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "amplify.amazonaws.com"
        }
      }
    },
    {
      "Sid": "IAMReadForTerraform",
      "Effect": "Allow",
      "Action": [
        "iam:ListPolicies",
        "iam:ListRoles",
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": "*"
    }
  ]
}
