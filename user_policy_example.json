{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ProofsBucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "*"
    },
    {
      "Sid": "Cognito",
      "Effect": "Allow",
      "Action": "cognito-idp:*",
      "Resource": "*"
    },
    {
      "Sid": "IAMReadForTerraform",
      "Effect": "Allow",
      "Action": [
        "iam:ListPolicies",
        "iam:ListRoles",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetRole",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IAMCleanupTerraform",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::868112351099:role/condoledger-prod-*",
        "arn:aws:iam::868112351099:policy/condoledger-prod-*"
      ]
    }
  ]
}
