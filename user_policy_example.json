{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ProofsBucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "*"
    },
    {
      "Sid": "Cognito",
      "Effect": "Allow",
      "Action": "cognito-idp:*",
      "Resource": "*"
    },
    {
      "Sid": "IAMReadForTerraform",
      "Effect": "Allow",
      "Action": [
        "iam:ListPolicies",
        "iam:ListRoles",
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": "*"
    }
  ]
}
