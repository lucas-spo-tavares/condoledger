{
  "name": "condoledger",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "bash bin/deploy.sh",
    "destroy": "bash bin/destroy.sh",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dynamodb:seed": "tsx scripts/seed-dynamodb.ts",
    "dynamodb:clear": "tsx scripts/clear-dynamodb.ts",
    "dynamodb:admin": "AWS_REGION=us-east-1 AWS_ACCESS_KEY_ID=local AWS_SECRET_ACCESS_KEY=local DYNAMO_ENDPOINT=http://localhost:8000 npx -y dynamodb-admin --port 8001"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "latest",
    "@aws-sdk/client-dynamodb": "latest",
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/lib-dynamodb": "latest",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.8",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "date-fns": "^4.1.0",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-day-picker": "^9.14.0",
    "react-dom": "latest",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "latest",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
